# --- Google Sheets Anbindung -------------------------------------------------
# ID des Tracking-Sheets (steht in der URL zwischen /d/ und /edit)
SPREADSHEET_ID=1a0L9E798ChgwWh7X0xZFoRnHi53RAIeqkno3-_Z25M0

# Pfad zur Service-Account-Schlüsseldatei (JSON), die du in der Google Cloud
# Console erstellt hast. Diese Datei NIEMALS ins Git committen!
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Alternativ: den kompletten JSON-Key als eine Zeile (z. B. für Hosting).
# Wenn gesetzt, hat dies Vorrang vor GOOGLE_APPLICATION_CREDENTIALS.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- Server ------------------------------------------------------------------
PORT=3000

# Wie lange (Sekunden) die Sheet-Daten gecached werden, bevor neu geladen wird.
CACHE_TTL_SECONDS=900

# Optionaler Passwortschutz fürs Dashboard (Basic Auth). Leer lassen = aus.
# Da die App standardmäßig nur lokal läuft, ist das optional.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- KI-Chatbot (optional) ---------------------------------------------------
# Anthropic-API-Key für den Analyse-Assistenten im Dashboard. Leer = Chat aus.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Facebook-Ads-Daten direkt via Meta Marketing API (optional) -------------
# Wenn gesetzt, hat dies Vorrang vor Supermetrics. Holt Spend/Impressionen/
# Klicks/Placement direkt aus Meta und führt sie über die Namen mit den Leads
# zusammen.
# META_ACCESS_TOKEN=        # Access-Token mit Berechtigung ads_read
# META_AD_ACCOUNT_ID=act_305949210219349   # mehrere Konten: kommagetrennt
# META_API_VERSION=v21.0    # optional
# META_LOOKBACK_DAYS=90     # optional, Zeitfenster

# --- Facebook-Ads-Daten via Supermetrics (optional) --------------------------
# Wenn gesetzt, holt das Dashboard Spend/Impressionen/Klicks/Placement live aus
# Supermetrics und führt sie über die Namen mit den Leads zusammen.
# Leer lassen = aus (Adspend kommt dann aus dem Sheet).

# SUPERMETRICS_API_KEY=
# Ad-Account(s), kommagetrennt (z. B. act_1234567890)
# SUPERMETRICS_DS_ACCOUNTS=
# Der verbundene Supermetrics-User (ds_user aus dem Accounts-Endpoint)
# SUPERMETRICS_DS_USER=
# Optional: komplette Abfrage als JSON (1:1 aus dem Supermetrics-Query-Builder).
# Hat Vorrang vor config/supermetrics.json -> der zuverlässigste Weg.
# SUPERMETRICS_QUERY_JSON={"ds_id":"FA","ds_accounts":["act_..."],"ds_user":"...","fields":["Campaign_name","Adset_name","Ad_name","publisher_platform","placement","cost","impressions","clicks","date"]}
